# Generador local de imagenes: herramienta de escritorio, no forma parte de la
# web. Se excluye entera, codigo incluido, por decision explicita.
/music-image-generator/

# Escenas aprobadas: se publican por SCP para no versionar 115 binarios.
/app/img/track-scenes/

# JV Studio dependencies are restored from its lockfile.
/apps/jvstudio/node_modules/

# JV Instrument Library: manifests and licences are versioned, sample binaries
# are published separately to the VPS so they do not grow Git history.
/apps/jvstudio/public/instruments/*/v1/samples/
/app/jvstudio/instruments/*/v1/samples/
