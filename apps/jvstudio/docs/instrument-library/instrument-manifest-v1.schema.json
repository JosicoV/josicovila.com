{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jvstudio.local/schemas/instrument-manifest-v1.schema.json",
  "title": "JV Instrument Manifest v1 (CONGELADO 2026-09-08)",
  "description": "Formato uniforme que JV Studio consume. CONGELADO el 2026-09-08: v1 no admite mas cambios incompatibles. El manifest debe ser autosuficiente: JV Studio no necesita conocer la estructura original de la libreria fuente.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "category",
    "engine",
    "source",
    "audio",
    "playback",
    "range",
    "velocityLayers",
    "samples"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "CONGELADO. Un cambio incompatible exige schemaVersion 2."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identificador estable en kebab-case, p. ej. jv-grand-piano."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "SemVer por instrumento; cada instrumento se versiona de forma independiente."
    },
    "category": {
      "type": "string",
      "enum": [
        "piano",
        "strings",
        "brass",
        "woodwinds",
        "percussion",
        "mallets",
        "world",
        "ensemble",
        "experimental",
        "other"
      ]
    },
    "engine": {
      "type": "string",
      "enum": [
        "sampler"
      ],
      "description": "CONGELADO en v1: 'sampler' es el unico motor. La extension 'drumkit' (docs/PROPUESTA-DRUMKIT.md) queda para v2. Este campo existe justamente para que anadirla despues no rompa nada: un consumidor de v1 rechaza limpiamente cualquier engine que no conozca."
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "license",
        "attributionRequired"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "enum": [
            "salamander",
            "vsco2",
            "vcsl",
            "iowa"
          ]
        },
        "name": {
          "type": "string"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": "string",
          "description": "Identificador SPDX, o LicenseRef-* para licencias no estándar.",
          "enum": [
            "CC0-1.0",
            "CC-BY-3.0",
            "LicenseRef-UIowa-MIS"
          ]
        },
        "licenseUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributionRequired": {
          "type": "boolean"
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ],
          "description": "Texto exacto que debe mostrarse. Obligatorio si attributionRequired es true."
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "description": "URL original de descarga."
        },
        "downloadedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "modifications": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Cambios aplicados respecto al master original. Exigido por CC BY."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "attributionRequired": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "attribution"
            ],
            "properties": {
              "attribution": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "audio": {
      "type": "object",
      "required": [
        "format",
        "sampleRate",
        "channels"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "ogg",
            "opus",
            "wav",
            "flac"
          ]
        },
        "codec": {
          "type": "string",
          "enum": [
            "vorbis",
            "opus",
            "pcm_s16le",
            "flac"
          ]
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "quality": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "playback": {
      "type": "object",
      "required": [
        "attack",
        "release",
        "gainDb"
      ],
      "additionalProperties": false,
      "description": "Parámetros recomendados. El release NO está horneado en el sample; lo aplica el motor.",
      "properties": {
        "attack": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "release": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "gainDb": {
          "type": "number",
          "minimum": -60,
          "maximum": 24
        },
        "loop": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "range": {
      "type": "object",
      "required": [
        "lowestMidi",
        "highestMidi"
      ],
      "additionalProperties": false,
      "properties": {
        "lowest": {
          "type": "string"
        },
        "highest": {
          "type": "string"
        },
        "lowestMidi": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "highestMidi": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      }
    },
    "velocityLayers": {
      "type": "array",
      "minItems": 1,
      "description": "Capas declaradas. Deben cubrir 1..127 sin solapes ni huecos.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "velocityMin",
          "velocityMax"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "velocityMin": {
            "type": "integer",
            "minimum": 1,
            "maximum": 127
          },
          "velocityMax": {
            "type": "integer",
            "minimum": 1,
            "maximum": 127
          }
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "description": "Mapa completo. Cada entrada es autosuficiente: JV Studio no interpreta nombres de archivo.",
      "items": {
        "type": "object",
        "required": [
          "file",
          "root",
          "rootMidi",
          "velocityMin",
          "velocityMax",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "description": "Ruta relativa al manifest, p. ej. samples/C4-mf.ogg. Los sostenidos se escriben 's' (Ds4), nunca '#': un '#' en la ruta abriría el fragmento de la URL y la petición fallaría con 404.",
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "root": {
            "type": "string",
            "description": "Nota raíz en notación científica, p. ej. C4."
          },
          "rootMidi": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "layer": {
            "type": "string",
            "description": "Nombre de la capa de velocity a la que pertenece."
          },
          "velocityMin": {
            "type": "integer",
            "minimum": 1,
            "maximum": 127
          },
          "velocityMax": {
            "type": "integer",
            "minimum": 1,
            "maximum": 127
          },
          "loNote": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 127,
            "description": "Extremo grave del rango que cubre este sample por transposición."
          },
          "hiNote": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 127
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "durationSec": {
            "type": "number",
            "minimum": 0
          },
          "peakDb": {
            "type": "number"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "durationSec": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "builtAt": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "toolVersion": {
          "type": "string"
        },
        "configSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
